{
  "_note": "Play library data (WP-15). Every number here is a starting default and a guess, replaced by measured rates after 30 outcomes; none is a benchmark. Plays A and B come from docs/plays/plays_draft.json; play C is designed for, not piloted.",
  "plays": [
    {
      "code": "A",
      "name": "Local, high-ticket, walk-in",
      "fits": "Dealers and showrooms where the sale closes in person and is often financed",
      "channels": [
        "google_business_profile",
        "whatsapp",
        "facebook",
        "instagram",
        "search_ads",
        "social_ads"
      ],
      "formats": [
        "single_image",
        "carousel",
        "offer",
        "proof_card",
        "short_video",
        "gbp_post"
      ],
      "booked_definition": "A showroom visit, a test drive or a callback slot with a date and time agreed",
      "bottlenecks_in_order": [
        "First response time to an enquiry",
        "Follow-up completed within 5 working days",
        "Finance readiness of the lead"
      ],
      "qualification_questions": [
        {
          "key": "model",
          "ask": "Which model are you looking at?",
          "type": "choice_from_catalogue"
        },
        {
          "key": "payment",
          "ask": "Cash or finance?",
          "type": "choice",
          "options": [
            "cash",
            "finance",
            "not_sure"
          ]
        },
        {
          "key": "down_payment_ready",
          "ask": "Do you have the down payment and documents ready?",
          "type": "choice",
          "options": [
            "yes",
            "partly",
            "no"
          ],
          "only_if": {
            "payment": "finance"
          }
        },
        {
          "key": "town",
          "ask": "Which town or area are you in?",
          "type": "text"
        },
        {
          "key": "timing",
          "ask": "When do you want to buy?",
          "type": "choice",
          "options": [
            "this_week",
            "this_month",
            "later"
          ]
        }
      ],
      "fit_rules": [
        {
          "if": {
            "timing": "this_week"
          },
          "add": 30
        },
        {
          "if": {
            "timing": "this_month"
          },
          "add": 20
        },
        {
          "if": {
            "payment": "cash"
          },
          "add": 25
        },
        {
          "if": {
            "payment": "finance",
            "down_payment_ready": "yes"
          },
          "add": 25
        },
        {
          "if": {
            "payment": "finance",
            "down_payment_ready": "partly"
          },
          "add": 10
        },
        {
          "if": {
            "payment": "finance",
            "down_payment_ready": "no"
          },
          "add": -10
        },
        {
          "if": {
            "town": "in_service_area"
          },
          "add": 20
        },
        {
          "if": {
            "model": "in_stock"
          },
          "add": 15
        }
      ],
      "fit_base": 10,
      "heat_actions": {
        "whatsapp_chat": 30,
        "call": 35,
        "walk_in_code": 40,
        "form": 25,
        "link": 8,
        "offer_view": 12
      },
      "routes": {
        "hot": {
          "fit_min": 60,
          "heat_min": 30
        },
        "warm": {
          "fit_min": 60,
          "heat_min": 0
        },
        "low_fit": {
          "fit_max": 59
        }
      },
      "pillar_mix": {
        "proof_and_deliveries": 0.3,
        "offers_and_finance": 0.25,
        "product_in_use": 0.25,
        "service_and_trust": 0.2
      },
      "stage_mix": {
        "awareness": 0.25,
        "consideration": 0.35,
        "conversion": 0.3,
        "retention": 0.1
      },
      "metrics": [
        "first_response_minutes",
        "followup_completion_rate",
        "qualified_leads",
        "booked_conversations",
        "finance_ready_bookings",
        "won_deals",
        "cost_per_booked_conversation"
      ],
      "headline_metric": "finance_ready_bookings",
      "weekly_volume": {
        "primary_pieces": 5,
        "max_channels_live": 3
      },
      "voice_questions_examples": [
        "Which vehicle left the showroom this week, and what will the owner use it for?",
        "What did a customer ask this week that you had to explain twice?",
        "What is in stock right now that you would recommend, and why?"
      ],
      "shot_list_examples": [
        "A 20-second clip of today's delivery, with the customer's consent",
        "Three photos of the model that arrived this week"
      ],
      "never": [
        "Promise a finance approval",
        "Quote an on-road price that is not a verified claim",
        "Message a lead without a consent basis"
      ],
      "status": "draft"
    },
