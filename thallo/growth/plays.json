        {
          "if": {
            "team_size": "2_to_5"
          },
          "add": 10
        },
        {
          "if": {
            "team_size": "6_to_20"
          },
          "add": 15
        },
        {
          "if": {
            "team_size": "over_20"
          },
          "add": 15
        },
        {
          "if": {
            "role": "budget_holder"
          },
          "add": 15
        },
        {
          "if": {
            "role": "evaluator"
          },
          "add": 10
        },
        {
          "if": {
            "email_domain": "company"
          },
          "add": 10
        }
      ],
      "fit_base": 5,
      "heat_actions": {
        "trial_start": 40,
        "pricing_page": 20,
        "demo_request": 45,
        "form": 25,
        "link": 6,
        "email_reply": 30,
        "comparison_page": 15
      },
      "routes": {
        "hot": {
          "fit_min": 55,
          "heat_min": 35
        },
        "warm": {
          "fit_min": 55,
          "heat_min": 0
        },
        "low_fit": {
          "fit_max": 54
        }
      },
      "pillar_mix": {
        "how_to_and_answers": 0.35,
        "comparisons_and_evaluation": 0.25,
        "customer_results": 0.2,
        "expert_point_of_view": 0.2
      },
      "stage_mix": {
        "awareness": 0.3,
        "consideration": 0.4,
        "conversion": 0.2,
        "retention": 0.1
      },
      "metrics": [
        "evaluation_query_impressions",
        "trial_starts",
        "trial_followup_hours",
        "qualified_leads",
        "booked_conversations",
        "won_deals",
        "cost_per_booked_conversation"
      ],
      "headline_metric": "booked_conversations",
      "weekly_volume": {
        "primary_pieces": 4,
        "max_channels_live": 3
      },
      "voice_questions_examples": [
        "What question did a prospect or trial user ask this week that deserves a full answer?",
        "Which result did a customer get recently that you can describe with numbers we can verify?",
        "What do people get wrong when they compare tools in this category?"
      ],
      "shot_list_examples": [
        "A 60-second screen recording of one task solved",
        "One chart from a real, consented customer result"
      ],
      "never": [
        "Name a competitor without a verified claim",
        "State a benchmark number that is not a verified claim",
        "Automate LinkedIn direct messages or connection requests"
      ],
      "status": "draft"
    },
