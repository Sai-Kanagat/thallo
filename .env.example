# Copy to .env and fill in by hand. Never commit .env.
LAUNCH_MODE=prelaunch
LLM_PROVIDER=mock
NOTION_TOKEN=
POSTIZ_API_KEY=
POSTIZ_API_URL=https://api.postiz.com/public/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Minutes between passes. 0 runs once.
CORTEX_LOOP_MINUTES=0

# Database. scripts/provision_db.py writes DATABASE_URL and DATABASE_WORKER_URL from the admin URL.
# Owner connection string (postgresql://...), used only to apply migrations.
DATABASE_ADMIN_URL=
# App connection as thallo_app, under row-level security.
DATABASE_URL=
# Job queue connection as thallo_worker.
DATABASE_WORKER_URL=

# Keys. scripts/gen_keys.py writes these straight into .env; never paste one here.
# Vault master key: base64 of 32 random bytes.
THALLO_VAULT_KEY=
# Older vault keys still needed to read old secrets during rotation, comma separated.
THALLO_VAULT_KEY_PREVIOUS=
# Approval signing key: hex of 32 or more random bytes. Unset blocks every publish.
THALLO_GATE_SIGNING_KEY=

# Operator settings.
# 1 lets every tenant use mock providers (development only); empty keeps mocks to mock tenants.
THALLO_ALLOW_MOCK=
# Absolute directory with one brand folder per tenant id, for the template image renderer.
THALLO_BRAND_ROOT=
# Path to a Chromium binary; empty searches this machine.
THALLO_CHROMIUM=
# Path of the env file the scripts read and write (default .env in the repo root). Left
# commented: an empty value is not the default.
# THALLO_ENV_FILE=.env
# Loopback base URL of the local text model. Left commented: an empty value is not the default.
# THALLO_LOCAL_TEXT_URL=http://127.0.0.1:11434
# Tenant ids allowed to use the local text model, comma separated, or * for all.
THALLO_LOCAL_TEXT_TENANTS=
# Origins the OpenAI-compatible provider may send its key to, e.g. https://api.openai.com
THALLO_OPENAI_COMPATIBLE_ORIGINS=
# The one self-hosted Postiz origin the Postiz key may go to, https://host[:port], no path.
# Empty means the self-hosted Postiz provider is unavailable (the chain falls through to manual).
THALLO_POSTIZ_SELF_HOSTED_ORIGIN=
