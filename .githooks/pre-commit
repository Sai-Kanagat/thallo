#!/bin/sh
# Blocks any commit whose staged changes contain a secret, or that breaks the repo rules.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, refusing to commit." >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner --config .gitleaks.toml . || exit 1

# Worktrees have no .venv of their own: fall back to the main checkout's.
PY=.venv/bin/python
if [ ! -x "$PY" ]; then
  MAIN="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
  PY="$MAIN/.venv/bin/python"
fi
[ -x "$PY" ] || PY=python3
"$PY" scripts/check_rules.py || { echo "pre-commit: repository rules failed." >&2; exit 1; }
"$PY" -m thallo.contracts.ddl | diff -q db/migrations/0001_core.sql - >/dev/null \
  || { echo "pre-commit: db/migrations/0001_core.sql does not match the models; regenerate it." >&2; exit 1; }
